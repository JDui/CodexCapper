{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "CodexCapper",
  "version": "1.1.0",
  "identifier": "com.codexcapper.widget",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Codex 额度",
        "width": 300,
        "height": 88,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "CodexCapper",
    "copyright": "Copyright (C) 2026 JDui",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/JDui/CodexCapper",
    "shortDescription": "Codex CLI 额度监控组件",
    "longDescription": "显示 Codex CLI 账号所有额度窗口的使用情况，可悬浮于桌面或固定到任务栏。",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
